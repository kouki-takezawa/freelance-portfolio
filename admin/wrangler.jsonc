{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-hp-admin",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "e37dfd650b9a4271b2bdb5b33e364b56"
    }
  ],
  // 投稿カレンダーのカード画像生成に使うフォントなど、JSバンドルに含めたくない静的ファイルの配信用
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
